# ---------------------------------------------------------------------------
# Supabase (projecto WNXT). A URL e a service_role key vivem no painel do
# Supabase: Project Settings -> API. A anon key NÃO serve: o RLS só permite
# INSERT em `events` para usuários autenticados, e o scraper roda sem sessão.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Faz todo o scraping + dedup e loga o que seria inserido, sem escrever nada.
DRY_RUN=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Pasta dos arquivos de log JSON-lines (uma por execução).
LOG_DIR=logs

# HTTP
SCRAPER_USER_AGENT=WNXT-EventScraper/0.1 (+https://wnxt.com.br; contato: dev@wnxt.com.br)
REQUEST_TIMEOUT_SECONDS=25
REQUEST_DELAY_SECONDS=3
MAX_RETRIES=3

# Fontes
SOURCES=technoairlines,plurstation
MAX_EVENTS_PER_SOURCE=40
# Enriquecer eventos da Techno Airlines abrindo a página de cada evento
# (JSON-LD da página) atrás de ticket, lineup completo e descrição.
TECHNOAIRLINES_ENRICH=true
TECHNOAIRLINES_MAX_ENRICH=15
# Cidades aceitas na Plurstation (slugs normalizados, separados por vírgula).
PLURSTATION_CITIES=sao paulo,carapicuiba,guarulhos,osasco,valinhos,campinas,barueri,santo andre,sao bernardo do campo,sao caetano do sul,diadema,maua,suzano,jundiai,sorocaba,santos,sao vicente,hortolandia,indaiatuba,ribeirao preto,sao jose dos campos
