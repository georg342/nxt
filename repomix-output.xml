<file path="src/stores/uiStore.js">
import { defineStore } from 'pinia'
import { computed, ref } from 'vue'
import i18n from '../i18n'

const THEME_LIGHT = 'light'
const THEME_DARK = 'dark'
const DEFAULT_THEME = THEME_LIGHT

const VALID_VIEWS = ['year', 'month', 'week', 'day']
// Boot straight into today's day view, mirroring goToToday().
const DEFAULT_VIEW = 'day'

const MIN_SEARCH_LENGTH = 3

/**
 * Selectable primary accent colors.
 * `contrast` is the text/icon color to use on top of `color`.
 * @typedef {Object} AccentPreset
 * @property {string} id
 * @property {string} label
 * @property {string} color
 * @property {string} contrast
 */

/** @type {AccentPreset[]} */
const ACCENT_PRESETS = [
  { id: 'yellow', label: 'Amarelo', color: '#FACC15', contrast: '#111111' },
  { id: 'orange', label: 'Laranja', color: '#FB923C', contrast: '#111111' },
  { id: 'pink', label: 'Rosa', color: '#F472B6', contrast: '#111111' },
  { id: 'lime', label: 'Lima', color: '#A3E635', contrast: '#111111' },
  { id: 'cyan', label: 'Ciano', color: '#22D3EE', contrast: '#111111' },
  { id: 'violet', label: 'Violeta', color: '#A78BFA', contrast: '#111111' },
]

const DEFAULT_ACCENT = 'yellow'

const VIEW_DEPTH = {
  year: 1,
  month: 2,
  week: 3,
  day: 4,
}

const DEFAULT_TRANSITION = 'ios-push'

const DEFAULT_LOCALE = 'pt'
const LOCALE_MAP = {
  pt: 'pt-BR',
  en: 'en-US',
}

/**
 * Returns a new Date set to Sunday 00:00 of the week containing `date`.
 * @param {Date} date
 * @returns {Date}
 */
function getWeekStart(date) {
  const result = new Date(date)
  result.setDate(result.getDate() - result.getDay())
  result.setHours(0, 0, 0, 0)
  return result
}

/**
 * Formats a Date as a local `YYYY-MM-DD` key, matching `event.start_date`.
 * @param {Date} date
 * @returns {string}
 */
function toDateKey(date) {
  const month = String(date.getMonth() + 1).padStart(2, '0')
  const day = String(date.getDate()).padStart(2, '0')
  return `${date.getFullYear()}-${month}-${day}`
}

/**
 * Formats a Date as "MMM D" (e.g., "Oct 14").
 * @param {Date} date
 * @param {string} intlLocale
 * @returns {string}
 */
function formatShortDate(date, intlLocale) {
  return new Intl.DateTimeFormat(intlLocale, {
    month: 'short',
    day: 'numeric',
  }).format(date)
}

/**
 * Resolves an accent preset by id, falling back to the default accent.
 * @param {string} presetId
 * @returns {AccentPreset}
 */
function getAccentPreset(presetId) {
  return (
    ACCENT_PRESETS.find((preset) => preset.id === presetId) ??
    ACCENT_PRESETS.find((preset) => preset.id === DEFAULT_ACCENT)
  )
}

/**
 * Applies the accent preset to the <html> element as inline CSS variables.
 * Inline values win over the `[data-theme]` declarations, so the user's
 * choice stays consistent across light/dark theme switches.
 * @param {AccentPreset} preset
 */
function applyAccentToDocument(preset) {
  if (typeof document === 'undefined') return
  const root = document.documentElement
  root.style.setProperty('--accent-color', preset.color)
  root.style.setProperty('--accent-contrast', preset.contrast)
}

/**
 * Applies the given theme to the <html> element via the data-theme attribute.
 * @param {'light' | 'dark'} theme
 */
function applyThemeToDocument(theme) {
  if (typeof document === 'undefined') return
  document.documentElement.setAttribute('data-theme', theme)
}

export const useUIStore = defineStore(
  'ui',
  () => {
    const theme = ref(DEFAULT_THEME)
    const locale = ref(DEFAULT_LOCALE)
    const accentPreset = ref(DEFAULT_ACCENT)
    const accentPresets = ref(ACCENT_PRESETS)
    const activeView = ref(DEFAULT_VIEW)
    const currentDate = ref(new Date())
    const selectedDate = ref(new Date())
    const transitionDirection = ref(DEFAULT_TRANSITION)
    const searchQuery = ref('')
    const isSearchOpen = ref(false)
    const isCreateEventModalOpen = ref(false)
    const editingEvent = ref(null)
    const isAdminPanelOpen = ref(false)
    const toast = ref({ show: false, message: '', type: 'success' })
    let toastTimeoutId = null

    const intlLocale = computed(() => LOCALE_MAP[locale.value] ?? 'en-US')

    const accentColor = computed(() => getAccentPreset(accentPreset.value).color)

    const accentContrast = computed(
      () => getAccentPreset(accentPreset.value).contrast
    )

    const normalizedSearchQuery = computed(() =>
      searchQuery.value.trim().toLowerCase()
    )

    const hasSearchQuery = computed(
      () => normalizedSearchQuery.value.length > 0
    )

    const hasMinSearchLength = computed(
      () => normalizedSearchQuery.value.length >= MIN_SEARCH_LENGTH
    )

    /**
     * Formats an event date as a full localized string (e.g., "Saturday, October 31, 2026").
     * Locked to America/Sao_Paulo timezone.
     * @param {string} isoDate
     * @returns {string}
     */
    function formatEventDate(isoDate) {
      if (!isoDate) return ''
      const date = new Date(`${isoDate}T12:00:00`)
      const formatted = new Intl.DateTimeFormat(intlLocale.value, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'America/Sao_Paulo',
      }).format(date)
      return formatted.charAt(0).toUpperCase() + formatted.slice(1)
    }

    /**
     * Formats a `YYYY-MM-DD` key as day + month (e.g., "11 de novembro").
     * Built in local time to avoid the UTC shift of `new Date(isoDate)`.
     * @param {string} isoDate
     * @returns {string}
     */
    function formatDayMonth(isoDate) {
      if (!isoDate) return ''
      const [year, month, day] = String(isoDate).slice(0, 10).split('-').map(Number)
      const date = new Date(year, month - 1, day)
      if (Number.isNaN(date.getTime())) return ''
      return new Intl.DateTimeFormat(intlLocale.value, {
        day: 'numeric',
        month: 'long',
      }).format(date)
    }

    const isTodaySelected = computed(() => {
      if (activeView.value !== 'day') return false
      const target = selectedDate.value ?? currentDate.value
      const today = new Date()
      return (
        target.getFullYear() === today.getFullYear() &&
        target.getMonth() === today.getMonth() &&
        target.getDate() === today.getDate()
      )
    })

    const contextLabel = computed(() => {
      const date = currentDate.value
      const intl = intlLocale.value

      if (activeView.value === 'year') {
        return String(date.getFullYear())
      }

      if (activeView.value === 'month') {
        const formatted = new Intl.DateTimeFormat(intl, {
          month: 'long',
          year: 'numeric',
        }).format(date)
        return formatted.charAt(0).toUpperCase() + formatted.slice(1)
      }

      if (activeView.value === 'week') {
        const weekStart = getWeekStart(date)
        const weekEnd = new Date(weekStart)
        weekEnd.setDate(weekStart.getDate() + 6)

        const sameMonth = weekStart.getMonth() === weekEnd.getMonth()
        const startLabel = sameMonth
          ? formatShortDate(weekStart, intl).split(' ')[1]
          : formatShortDate(weekStart, intl)
        const endLabel = formatShortDate(weekEnd, intl)

        return sameMonth
          ? `${formatShortDate(weekStart, intl).split(' ')[0]} ${startLabel} - ${endLabel}`
          : `${startLabel} - ${endLabel}`
      }

      if (activeView.value === 'day') {
        const target = selectedDate.value ?? date
        const formatted = new Intl.DateTimeFormat(intl, {
          weekday: 'long',
          month: 'long',
          day: 'numeric',
        }).format(target)
        return formatted.charAt(0).toUpperCase() + formatted.slice(1)
      }

      return ''
    })

    const weekDaysData = computed(() => {
      const weekStart = getWeekStart(currentDate.value)
      const intl = intlLocale.value
      const weekdayFormatter = new Intl.DateTimeFormat(intl, {
        weekday: 'short',
      })

      return Array.from({ length: 7 }, (_, i) => {
        const day = new Date(weekStart)
        day.setDate(weekStart.getDate() + i)
        return {
          dateKey: toDateKey(day),
          dateNum: day.getDate(),
          dayName: weekdayFormatter.format(day).replace('.', '').toUpperCase(),
        }
      })
    })

    /**
     * Sets the theme and applies it to the document.
     * @param {'light' | 'dark'} newTheme
     */
    function setTheme(newTheme) {
      theme.value = newTheme === THEME_DARK ? THEME_DARK : THEME_LIGHT
      applyThemeToDocument(theme.value)
    }

    /**
     * Toggles between light and dark themes.
     */
    function toggleTheme() {
      setTheme(theme.value === THEME_DARK ? THEME_LIGHT : THEME_DARK)
    }

    /**
     * Toggles between 'pt' and 'en' locales and syncs vue-i18n.
     */
    function toggleLocale() {
      locale.value = locale.value === 'pt' ? 'en' : 'pt'
      i18n.global.locale.value = locale.value
    }

    /**
     * Sets the primary accent color preset and applies it to the document.
     * @param {string} presetId
     */
    function setAccentColor(presetId) {
      const preset = getAccentPreset(presetId)
      accentPreset.value = preset.id
      applyAccentToDocument(preset)
    }

    /**
     * Ensures the persisted accent color is applied to the document.
     * Useful on app bootstrap after persisted state hydration.
     */
    function initAccentColor() {
      applyAccentToDocument(getAccentPreset(accentPreset.value))
    }

    /**
     * Ensures the current theme (and accent color) is applied to the document.
     * Useful on app bootstrap after persisted state hydration.
     */
    function initTheme() {
      applyThemeToDocument(theme.value)
      initAccentColor()
    }

    /**
     * Sets the active calendar view.
     * @param {'year' | 'month' | 'week' | 'day'} viewName
     */
    function setActiveView(viewName) {
      if (!VALID_VIEWS.includes(viewName)) return
      if (viewName === activeView.value) return

      const currentDepth = VIEW_DEPTH[activeView.value] ?? 0
      const nextDepth = VIEW_DEPTH[viewName] ?? 0

      transitionDirection.value =
        nextDepth >= currentDepth ? 'ios-push' : 'ios-pop'

      activeView.value = viewName
    }

    /**
     * Advances to the next week.
     */
    function nextWeek() {
      const next = new Date(currentDate.value)
      next.setDate(next.getDate() + 7)
      currentDate.value = next
    }

    /**
     * Moves back to the previous week without leaving the week view.
     */
    function prevWeek() {
      const prev = new Date(currentDate.value)
      prev.setDate(prev.getDate() - 7)
      currentDate.value = prev
    }

    /**
     * Shifts the reference date by `delta` periods of the active view,
     * staying in the same view. Day view moves `selectedDate` as well,
     * since that is what the day feed renders.
     * @param {number} delta
     */
    function stepDate(delta) {
      const isDay = activeView.value === 'day'
      const next = new Date(
        isDay ? selectedDate.value ?? currentDate.value : currentDate.value
      )

      if (activeView.value === 'year') {
        next.setFullYear(next.getFullYear() + delta)
      } else if (activeView.value === 'month') {
        next.setMonth(next.getMonth() + delta)
      } else {
        next.setDate(next.getDate() + delta * (isDay ? 1 : 7))
      }

      currentDate.value = next
      if (isDay) selectedDate.value = new Date(next)
    }

    /**
     * Moves to the previous period of the active view.
     */
    function navigatePrev() {
      stepDate(-1)
    }

    /**
     * Moves to the next period of the active view.
     */
    function navigateNext() {
      stepDate(1)
    }

    /**
     * Navigates back one level in the view hierarchy.
     * day -> week, week -> month, month -> year, year -> -1 year.
     * When leaving the day view, keeps the currentDate anchored to the
     * selected day so the parent view (week/month) shows the correct period.
     */
    function goToPrevious() {
      if (activeView.value === 'day') {
        if (selectedDate.value) {
          currentDate.value = new Date(selectedDate.value)
        }
        setActiveView('week')
        return
      }

      if (activeView.value === 'week') {
        setActiveView('month')
        return
      }

      if (activeView.value === 'month') {
        setActiveView('year')
        return
      }

      const next = new Date(currentDate.value)
      next.setFullYear(next.getFullYear() - 1)
      currentDate.value = next
    }

    /**
     * Selects a specific date and opens the day view.
     * @param {Date} date
     */
    function selectDate(date) {
      selectedDate.value = new Date(date)
      setActiveView('day')
    }

    /**
     * Opens the month view for the given month of the currently displayed year.
     * @param {number} monthIndex 0-11
     */
    function goToMonth(monthIndex) {
      const next = new Date(currentDate.value)
      // setDate first so short months don't overflow (e.g. Feb 31).
      next.setDate(1)
      next.setMonth(monthIndex)
      currentDate.value = next
      setActiveView('month')
    }

    /**
     * Opens the day view for today's date.
     */
    function goToToday() {
      const today = new Date()
      currentDate.value = today
      selectDate(today)
    }

    /**
     * Opens the week view for the week containing today.
     */
    function goToCurrentWeek() {
      currentDate.value = new Date()
      setActiveView('week')
    }

    /**
     * Opens the search field.
     */
    function openSearch() {
      isSearchOpen.value = true
    }

    /**
     * Closes the search field and clears the query.
     */
    function closeSearch() {
      isSearchOpen.value = false
      searchQuery.value = ''
    }

    /**
     * Toggles the search field visibility.
     */
    function toggleSearch() {
      if (isSearchOpen.value) {
        closeSearch()
      } else {
        openSearch()
      }
    }

    /**
     * Shows a toast notification, replacing any active one.
     * @param {string} message
     * @param {'success' | 'error' | 'info'} [type]
     * @param {number} [duration]
     */
    function showToast(message, type = 'success', duration = 3000) {
      if (toastTimeoutId) {
        clearTimeout(toastTimeoutId)
        toastTimeoutId = null
      }

      toast.value = { show: true, message, type }

      toastTimeoutId = setTimeout(() => {
        toast.value = { ...toast.value, show: false }
        toastTimeoutId = null
      }, duration)
    }

    /**
     * Hides the toast notification immediately.
     */
    function hideToast() {
      if (toastTimeoutId) {
        clearTimeout(toastTimeoutId)
        toastTimeoutId = null
      }
      toast.value = { ...toast.value, show: false }
    }

    /**
     * Opens the create event modal.
     */
    function openCreateEventModal() {
      isCreateEventModalOpen.value = true
    }

    /**
     * Closes the create event modal.
     */
    function closeCreateEventModal() {
      isCreateEventModalOpen.value = false
    }

    /**
     * Stages an event for editing; CreateEventModal reads this to switch modes.
     * @param {Object|null} event
     */
    function startEditing(event) {
      editingEvent.value = event
    }

    /**
     * Clears the staged event, returning the modal to creation mode.
     */
    function cancelEditing() {
      editingEvent.value = null
    }

    /**
     * Opens the admin CMS panel.
     */
    function openAdminPanel() {
      isAdminPanelOpen.value = true
    }

    /**
     * Toggles the admin CMS panel visibility.
     */
    function toggleAdminPanel() {
      isAdminPanelOpen.value = !isAdminPanelOpen.value
    }

    /**
     * Closes the admin CMS panel.
     */
    function closeAdminPanel() {
      isAdminPanelOpen.value = false
    }

    return {
      theme,
      locale,
      accentPreset,
      accentPresets,
      accentColor,
      accentContrast,
      activeView,
      currentDate,
      selectedDate,
      transitionDirection,
      contextLabel,
      weekDaysData,
      isTodaySelected,
      hasSearchQuery,
      hasMinSearchLength,
      formatEventDate,
      formatDayMonth,
      setTheme,
      toggleTheme,
      toggleLocale,
      setAccentColor,
      initAccentColor,
      initTheme,
      searchQuery,
      isSearchOpen,
      isCreateEventModalOpen,
      editingEvent,
      isAdminPanelOpen,
      toast,
      setActiveView,
      nextWeek,
      prevWeek,
      stepDate,
      navigatePrev,
      navigateNext,
      goToPrevious,
      selectDate,
      goToMonth,
      goToToday,
      goToCurrentWeek,
      openSearch,
      closeSearch,
      toggleSearch,
      openCreateEventModal,
      closeCreateEventModal,
      startEditing,
      cancelEditing,
      openAdminPanel,
      closeAdminPanel,
      toggleAdminPanel,
      showToast,
      hideToast,
    }
  },
  {
    persist: {
      key: 'wnxt-ui',
      // activeView is intentionally not persisted so every boot starts at today.
      pick: ['theme', 'locale', 'accentPreset'],
    },
  }
)
</file>

<file path="src/components/calendar/DayFeed.vue">
<script setup>
import { computed, ref, watch } from 'vue'
import { useI18n } from 'vue-i18n'
import EventCard from './EventCard.vue'
import { useEventStore } from '../../stores/eventStore'
import { useUIStore } from '../../stores/uiStore'

const eventStore = useEventStore()
const uiStore = useUIStore()
const { t } = useI18n()

const expandedEventId = ref(null)

const touchStartX = ref(0)
const touchStartY = ref(0)
const touchEndX = ref(0)
const touchEndY = ref(0)

function handleTouchStart(event) {
  const touch = event.changedTouches[0]
  touchStartX.value = touch.clientX
  touchStartY.value = touch.clientY
}

function handleTouchEnd(event) {
  const touch = event.changedTouches[0]
  touchEndX.value = touch.clientX
  touchEndY.value = touch.clientY
  handleSwipe()
}

function handleSwipe() {
  const deltaX = touchEndX.value - touchStartX.value
  const deltaY = touchEndY.value - touchStartY.value

  if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 50) {
    if (deltaX > 50) {
      uiStore.navigatePrev()
    } else if (deltaX < -50) {
      uiStore.navigateNext()
    }
  }
}

function toggleEvent(id) {
  expandedEventId.value = expandedEventId.value === id ? null : id
}

function formatTime(dateString) {
  if (!dateString) return ''
  const date = new Date(dateString)
  return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
}

const filteredEvents = computed(() => {
  const referenceDate = uiStore.selectedDate ?? new Date()
  const targetYear = referenceDate.getFullYear()
  const targetMonth = referenceDate.getMonth()
  const targetDay = referenceDate.getDate()

  return eventStore.events.filter((event) => {
    if (!event.start_date) return false
    const eventDate = new Date(event.start_date)
    return (
      eventDate.getFullYear() === targetYear &&
      eventDate.getMonth() === targetMonth &&
      eventDate.getDate() === targetDay
    )
  })
})

function toDateKey(date) {
  const pad = (value) => String(value).padStart(2, '0')
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`
}

// Days after the selected one, grouped by date. eventStore.events already
// holds every approved event ordered by start_date, so no extra request.
const upcomingGroups = computed(() => {
  const referenceDate = uiStore.selectedDate ?? new Date()
  const selectedDay = new Date(
    referenceDate.getFullYear(),
    referenceDate.getMonth(),
    referenceDate.getDate()
  )

  const groups = new Map()
  for (const event of eventStore.events) {
    if (!event.start_date) continue
    const eventDate = new Date(event.start_date)
    if (Number.isNaN(eventDate.getTime())) continue
    const eventDay = new Date(
      eventDate.getFullYear(),
      eventDate.getMonth(),
      eventDate.getDate()
    )
    if (eventDay <= selectedDay) continue

    const key = toDateKey(eventDay)
    if (!groups.has(key)) {
      groups.set(key, {
        key,
        label: uiStore.formatDayMonth(key),
        events: [],
      })
    }
    groups.get(key).events.push(event)
  }
  return [...groups.values()]
})

// Refetch on every entry into the day view and whenever the selected day
// changes (arrow navigation keeps the component mounted).
watch(
  () => uiStore.selectedDate,
  () => {
    eventStore.loadEvents()
  },
  { immediate: true }
)
</script>

<template>
  <div
    class="day-feed"
    @touchstart.passive="handleTouchStart"
    @touchend.passive="handleTouchEnd"
  >
    <p v-if="eventStore.isLoading" class="day-feed__state">Loading...</p>
    <template v-else>
      <p v-if="filteredEvents.length === 0" class="day-feed__state">
        {{ t('dayView.noEvents') }}
      </p>
      <EventCard
        v-for="event in filteredEvents"
        :key="event.id"
        :event="event"
        :time="formatTime(event.start_date)"
        :expanded="expandedEventId === event.id"
        @toggle="toggleEvent(event.id)"
      />
      <template v-if="upcomingGroups.length > 0">
        <h2 class="day-feed__section-title">
          {{ t('dayView.upcomingEvents') }}
        </h2>
        <section
          v-for="group in upcomingGroups"
          :key="group.key"
          class="day-feed__group"
        >
          <h3 class="day-feed__group-title">{{ group.label }}</h3>
          <EventCard
            v-for="event in group.events"
            :key="event.id"
            :event="event"
            :time="formatTime(event.start_date)"
            :expanded="expandedEventId === event.id"
            @toggle="toggleEvent(event.id)"
          />
        </section>
      </template>
    </template>
  </div>
</template>

