<file path="src/components/calendar/EventCard.vue">
<script setup>
import { computed, ref } from 'vue'
import { PhCalendarBlank, PhClock, PhInstagramLogo, PhMapPin } from '@phosphor-icons/vue'
import BrutalCard from '../ui/BrutalCard.vue'
import { useUIStore } from '../../stores/uiStore'
import { useGenreStore } from '../../stores/genreStore'

const props = defineProps({
  event: {
    type: Object,
    required: true,
  },
  time: {
    type: String,
    default: '',
  },
  expanded: {
    type: Boolean,
    default: false,
  },
})

const uiStore = useUIStore()
const genreStore = useGenreStore()

const isExpanded = ref(false)

const parsePills = (data) => {
  if (!data) return []
  if (Array.isArray(data)) {
    return data.map((item) => {
      if (typeof item === 'string') {
        try {
          return JSON.parse(item)
        } catch (e) {
          return { LABEL: item, COLOR: '#e5e7eb' }
        }
      }
      return item
    })
  }
  if (typeof data === 'string') {
    try {
      const parsed = JSON.parse(data)
      return Array.isArray(parsed) ? parsed : [parsed]
    } catch (e) {
      return []
    }
  }
  return []
}

function getShortAddress(address) {
  if (!address) return ''
  const parts = address.split(',').map((p) => p.trim()).filter(Boolean)
  if (parts.length >= 3) {
    const neighborhood = parts[1]
    const city = parts[2]
    const state = parts[3] || ''
    return state ? `${neighborhood}, ${city} - ${state}` : `${neighborhood}, ${city}`
  }
  return address.length > 30 ? `${address.slice(0, 30)}…` : address
}

const formattedDate = computed(() =>
  uiStore.formatEventDate(props.event.start_date?.slice(0, 10))
)

// Resolves relational genre rows (or legacy strings) into display pills.
const genrePills = computed(() =>
  parsePills(props.event.genres).map((pill) =>
    genreStore.getGenreDisplay(
      typeof pill === 'string'
        ? pill
        : pill?.id ?? pill?.name ?? pill?.LABEL ?? pill?.label
    )
  )
)

function formatTime(dateString) {
  if (!dateString) return ''
  const date = new Date(dateString)
  return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
}

const displayTime = computed(() => props.time || formatTime(props.event.start_date))
</script>

<template>
  <BrutalCard
    class="event-card"
    @click="isExpanded = !isExpanded"
  >
    <div class="event-card__header">
      <h2 class="event-card__title">{{ event.title }}</h2>
      <div class="event-card__meta">
        <span
          v-if="formattedDate"
          class="event-card__meta-item"
        >
          <PhCalendarBlank :size="18" weight="duotone" />
          {{ formattedDate }}
        </span>
        <div
          v-if="displayTime"
          class="event-time"
          style="display: flex; align-items: center; gap: 4px; margin-top: 4px; font-weight: 600;"
        >
          <PhClock :size="18" weight="duotone" />
          <span>{{ displayTime }}</span>
        </div>
        <span class="event-card__meta-item">
          <PhMapPin :size="18" weight="duotone" />
          <span v-show="!isExpanded" class="address-short">{{ getShortAddress(event.location) }}</span>
          <span v-show="isExpanded" class="address-full">{{ event.location }}</span>
        </span>
      </div>
    </div>

    <Transition name="accordion">
      <div
        v-if="isExpanded"
        class="event-card__body"
      >
        <div
          v-if="genrePills.length"
          class="event-card__genres"
        >
          <span
            v-for="(genre, index) in genrePills"
            :key="`genre-${index}`"
            class="pill"
            :style="{ backgroundColor: genre.color }"
          >
            {{ genre.name }}
          </span>
        </div>
        <div
          v-if="parsePills(event.lineup).length"
          class="event-card__lineup"
        >
          <span
            v-for="(pill, index) in parsePills(event.lineup)"
            :key="`lineup-${index}`"
            class="pill"
