<file path="src/components/ui/TagInput.vue">
<script setup>
import { computed, ref } from 'vue'
import { PhX } from '@phosphor-icons/vue'

const props = defineProps({
  modelValue: {
    type: Array,
    default: () => [],
  },
  label: {
    type: String,
    default: 'Adicionar...',
  },
  placeholder: {
    type: String,
    default: '',
  },
})

const emit = defineEmits(['update:modelValue'])

const PILL_COLORS = [
  '#a3e635',
  '#fb923c',
  '#22d3ee',
  '#f472b6',
  '#facc15',
  '#c084fc',
  '#6ee7b7',
  '#f87171',
]

// Accepts strings or { label, color } pills; empty entries are dropped so a
// blank chip with an "x" is never rendered.
const pills = computed(() =>
  props.modelValue
    .map((item, index) => {
      const label =
        typeof item === 'string' ? item : (item?.label ?? item?.LABEL ?? '')
      const trimmed = String(label).trim()
      if (!trimmed) return null
      const color =
        typeof item === 'string'
          ? PILL_COLORS[index % PILL_COLORS.length]
          : (item?.color ??
            item?.COLOR ??
            PILL_COLORS[index % PILL_COLORS.length])
      return { label: trimmed, color }
    })
    .filter(Boolean)
)

const inputValue = ref('')

function randomColor() {
  const previous = props.modelValue[props.modelValue.length - 1]?.color
  const available = PILL_COLORS.filter((color) => color !== previous)
  return available[Math.floor(Math.random() * available.length)]
}

function addTag() {
  const value = inputValue.value.trim()
  if (!value) return
  if (pills.value.some((tag) => tag.label === value)) {
    inputValue.value = ''
    return
  }
  emit('update:modelValue', [...pills.value, { label: value, color: randomColor() }])
  inputValue.value = ''
}

function onInput(event) {
  const value = event.target.value
  if (!value.includes(',')) {
    inputValue.value = value
    return
  }
  const parts = value.split(',')
  const last = parts.pop()
  let next = [...pills.value]
  parts.forEach((part) => {
    const trimmed = part.trim()
    if (!trimmed) return
    if (next.some((tag) => tag.label === trimmed)) return
    next = [...next, { label: trimmed, color: randomColor() }]
  })
  emit('update:modelValue', next)
  inputValue.value = last
}

function removeTag(index) {
  // Emitting the normalized list drops any invalid entry left in the state.
  emit(
    'update:modelValue',
    pills.value.filter((_, i) => i !== index)
  )
}
</script>

<template>
  <div class="tag-input">
    <div v-if="pills.length > 0" class="tag-input__pills">
      <span
        v-for="(tag, index) in pills"
        :key="`${tag.label}-${index}`"
        class="tag-input__pill"
        :style="{ backgroundColor: tag.color }"
      >
        {{ tag.label }}
        <button
          type="button"
          class="tag-input__remove"
          :aria-label="`Remove ${tag.label}`"
          @click="removeTag(index)"
        >
          <PhX :size="12" weight="bold" />
        </button>
      </span>
    </div>
    <div class="tag-input__field-wrap">
      <input
        :value="inputValue"
        type="text"
        class="tag-input__field peer"
        :placeholder="placeholder || ' '"
        @input="onInput"
        @keydown.enter.prevent="addTag()"
        @blur="addTag()"
      />
      <label class="tag-input__label">{{ label }}</label>
    </div>
  </div>
</template>

<style scoped>
