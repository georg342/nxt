/* ============================================================
   WNXT — Global Styles (Neo-Brutalism Design System)
   ============================================================ */

/* ---------- CSS Reset ---------- */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  user-select: none;
}

html,
body {
  height: 100%;
}

body {
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img,
picture,
video,
canvas,
svg {
  display: block;
  max-width: 100%;
}

input,
button,
textarea,
select {
  font: inherit;
  color: inherit;
}

input,
textarea {
  -webkit-user-select: auto;
  user-select: auto;
}

button {
  cursor: pointer;
  background: none;
  border: none;
}

a {
  color: inherit;
  text-decoration: none;
}

ul,
ol {
  list-style: none;
}

/* ---------- Design Tokens ---------- */
:root {
  /* Geometry */
  --border-width: 2px;
  --border-width-strong: 3px;
  --radius-card: 8px;
  --radius-button: 8px;
  --radius-grid: 0px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --hit-area-min: 44px;

  /* Typography */
  --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: ui-monospace, "SFMono-Regular", Menlo, monospace;

  /* Spacing */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;

  /* Transitions */
  --transition-fast: 120ms ease;

  /* Button content color (text + icons only) */
}

/* ---------- Light Theme ---------- */
[data-theme="light"] {
  --bg-color: #F3F4F6;
  --surface-color: #FFFFFF;
  --text-color: #111827;
  --text-muted: #4B5563;
  --border-color: #111827;
  --shadow-color: #111827;
  --accent-color: #84CC16; /* Verde limão escuro */
  --accent-contrast: #000000;
  --danger-color: #DC2626;
  --success-color: #16A34A;
  --button-text-color: #000000;
  --shadow-1: 4px 4px 0px var(--shadow-color);
  --shadow-2: 8px 8px 0px var(--shadow-color);
  --shadow-hover: 2px 2px 0px var(--shadow-color);
}

/* ---------- Dark Theme ---------- */
[data-theme="dark"] {
  --bg-color: #141312; /* Chumbo/Asfalto com tom quente */
  --surface-color: #211F1D; 
  --text-color: #EBE6E0;
  --text-muted: #8F877D;
  --border-color: #3B3530;
  --shadow-color: #000000;
  --accent-color: #FF5E00; /* Laranja Radioativo */
  --accent-contrast: #FFFFFF;
  --danger-color: #E11D48;
  --success-color: #16A34A;
  --button-text-color: #FFFFFF;
  --shadow-1: 4px 4px 0px var(--shadow-color);
  --shadow-2: 8px 8px 0px var(--shadow-color);
  --shadow-hover: 2px 2px 0px var(--shadow-color);
}
/* ---------- Base ---------- */
html {
  color-scheme: light dark;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-color);
  color: var(--text-color);
  min-height: 100dvh;
  transition: background-color var(--transition-fast),
    color var(--transition-fast);
}

#app {
  min-height: 100dvh;
}

/* ---------- View Transitions ---------- */
.view-fade-enter-active,
.view-fade-leave-active {
  transition: opacity 0.15s ease-out, transform 0.15s ease-out;
}

.view-fade-enter-from,
.view-fade-leave-to {
  opacity: 0;
  transform: scale(0.98) translateY(10px);
}

/* ---------- Fade Text ---------- */
.fade-text-enter-active,
.fade-text-leave-active {
  transition: all 0.2s ease;
}

.fade-text-enter-from {
  opacity: 0;
  transform: translateY(5px);
}

.fade-text-leave-to {
  opacity: 0;
  transform: translateY(-5px);
}

/* ---------- Fade Slide (date title) ---------- */
.fade-slide-enter-active,
.fade-slide-leave-active {
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.fade-slide-enter-from,
.fade-slide-leave-to {
  opacity: 0;
  transform: translateY(5px);
}

/* ---------- iOS 18 Spatial Navigation ---------- */
.ios-push-enter-active,
.ios-push-leave-active,
.ios-pop-enter-active,
.ios-pop-leave-active {
  position: absolute;
  width: 100%;
  height: 100%;
  transition: all 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  will-change: transform, opacity, filter;
}

.ios-push-enter-from {
  transform: translateX(100%);
}

.ios-push-leave-to {
  transform: scale(0.92) translateX(-20%);
  opacity: 0;
  filter: blur(2px);
}

.ios-pop-enter-from {
  transform: scale(0.92) translateX(-20%);
  opacity: 0;
  filter: blur(2px);
}

.ios-pop-leave-to {
  transform: translateX(100%);
}

/* ---------- Week Swipe (Cascading Domino) ---------- */
/* The wrapper holds the Vue transition timing (0.4s animation + 0.25s max delay = ~0.65s) */
.swipe-week-enter-active,
.swipe-week-leave-active {
  transition: opacity 0.65s ease;
}

/* The individual cards do the physical iOS-style movement */
.swipe-week-enter-active .day-card,
.swipe-week-leave-active .day-card {
  transition: all 0.4s cubic-bezier(0.32, 0.72, 0, 1);
}

/* Entering cards start from the right */
.swipe-week-enter-from .day-card {
  transform: translateX(60px);
  opacity: 0;
}

/* Leaving cards go to the left */
.swipe-week-leave-to .day-card {
  transform: translateX(-60px);
  opacity: 0;
}

/* Staggering delays for each card (Domino effect) */
.day-card:nth-child(1) { transition-delay: 0ms; }
.day-card:nth-child(2) { transition-delay: 35ms; }
.day-card:nth-child(3) { transition-delay: 70ms; }
.day-card:nth-child(4) { transition-delay: 105ms; }
.day-card:nth-child(5) { transition-delay: 140ms; }
.day-card:nth-child(6) { transition-delay: 175ms; }
.day-card:nth-child(7) { transition-delay: 210ms; }

/* ---------- Button Content Color (buttons only) ---------- */
/* Scoped to buttons: never leaks to text/icons outside a button. */
button,
[role="button"],
.nb-button {
  color: var(--button-text-color);
}

/* Icons inside buttons follow the button color (Phosphor renders filled SVG paths). */
button svg,
[role="button"] svg,
.nb-button svg {
  color: inherit;
  fill: currentColor;
}

/* ---------- Button Variant: actionBtnWhiteText ---------- */
/* Opt-in variant that forces button text/icons to white.
   Uses compound selectors so specificity (0,1,1 / 0,2,0) reliably beats
   `button`, `[role="button"]`, `.nb-button`*/
button.actionBtnWhiteText,
[role="button"].actionBtnWhiteText,
.nb-button.actionBtnWhiteText {
  color: #ffffff;
}

button.actionBtnWhiteText svg,
[role="button"].actionBtnWhiteText svg,
.nb-button.actionBtnWhiteText svg {
  color: inherit;
  fill: currentColor;
}

/* ---------- Utility: Neo-Brutalist Card ---------- */
.nb-card {
  background-color: var(--surface-color);
  border: var(--border-width-strong) solid var(--border-color);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-1);
}

.nb-button {
  min-height: var(--hit-area-min);
  min-width: var(--hit-area-min);
  padding: var(--space-2) var(--space-4);
  background-color: var(--surface-color);
