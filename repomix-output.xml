<script setup>
import { ref, watch } from 'vue'

const props = defineProps({
  modelValue: {
    type: String,
    default: '',
  },
  label: {
    type: String,
    default: 'Localização',
  },
})

const emit = defineEmits(['update:modelValue'])

const searchQuery = ref(props.modelValue)
const results = ref([])
const isOpen = ref(false)
const isSearching = ref(false)
const searchInput = ref(null)
let debounceId = null

watch(
  () => props.modelValue,
  (value) => {
    if (value !== searchQuery.value) {
      searchQuery.value = value
    }
  }
)

function onInput(event) {
  const value = event.target.value
  searchQuery.value = value
  emit('update:modelValue', value)

  if (debounceId) clearTimeout(debounceId)

  if (value.trim().length < 3) {
    results.value = []
    isSearching.value = false
    isOpen.value = true
    return
  }

  isSearching.value = true
  isOpen.value = true

  debounceId = setTimeout(async () => {
    try {
      const response = await fetch(
        `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(value)}&format=json&limit=5`
      )
      const data = await response.json()
      results.value = Array.isArray(data) ? data : []
      isOpen.value = true
    } catch (err) {
      console.error('[LocationAutocomplete] fetch error:', err)
      results.value = []
      isOpen.value = true
    } finally {
      isSearching.value = false
    }
  }, 500)
}

function onFocus() {
  isOpen.value = true
}

function selectResult(result) {
  searchQuery.value = result.display_name
  emit('update:modelValue', result.display_name)
  isOpen.value = false
  results.value = []
  isSearching.value = false
  searchInput.value?.blur()
}

function onBlur() {
  setTimeout(() => {
    isOpen.value = false
  }, 150)
}
</script>

<template>
  <div class="location-autocomplete" :class="{ 'is-open': isOpen }">
    <div class="location-autocomplete__field-wrap">
      <input
        ref="searchInput"
        type="text"
        class="location-autocomplete__input peer"
        placeholder=" "
        :value="searchQuery"
        @input="onInput"
        @focus="onFocus"
        @blur="onBlur"
      />
      <label class="location-autocomplete__label">{{ label }}</label>
    </div>
    <Transition name="dropdown">
      <ul v-if="isOpen" class="location-autocomplete__dropdown">
        <li
          v-if="isSearching"
          class="location-autocomplete__item location-autocomplete__item--state"
        >
          Buscando...
        </li>
        <li
          v-else-if="searchQuery.trim().length < 3"
          class="location-autocomplete__item location-autocomplete__item--state"
        >
          Aguardando
        </li>
        <li
          v-else-if="results.length === 0"
          class="location-autocomplete__item location-autocomplete__item--state"
        >
          Nenhum resultado encontrado.
        </li>
        <li
          v-for="(result, index) in results"
          v-else
          :key="index"
          class="location-autocomplete__item"
          @mousedown.prevent="selectResult(result)"
        >
          {{ result.display_name }}
        </li>
      </ul>
    </Transition>
  </div>
</template>

